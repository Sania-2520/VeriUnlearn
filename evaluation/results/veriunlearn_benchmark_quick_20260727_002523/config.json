{
  "experiment_name": "veriunlearn_benchmark_quick",
  "description": "VeriUnlearn unlearning algorithm evaluation",
  "seeds": {
    "global_seed": 42,
    "numpy_seed": 42,
    "torch_seed": 42,
    "cuda_seed": 42,
    "python_hash_seed": 42
  },
  "datasets": [
    {
      "name": "mnist",
      "root": "evaluation/data",
      "max_samples": 2000,
      "train_split": 0.8,
      "val_split": 0.1,
      "test_split": 0.1,
      "num_classes": 10,
      "input_shape": [
        1,
        28,
        28
      ],
      "vocab_size": 30000,
      "max_seq_length": 512,
      "normalize": true,
      "mean": [
        0.1307
      ],
      "std": [
        0.3081
      ]
    }
  ],
  "model": {
    "name": "logistic_regression",
    "hidden_dim": 128,
    "num_layers": 2,
    "dropout": 0.1,
    "lora_r": 8,
    "lora_alpha": 16,
    "lora_dropout": 0.1,
    "lora_target_modules": [
      "q_proj",
      "v_proj"
    ]
  },
  "training": {
    "batch_size": 64,
    "learning_rate": 0.001,
    "weight_decay": 0.0001,
    "num_epochs": 3,
    "warmup_steps": 100,
    "max_grad_norm": 1.0,
    "optimizer": "adamw",
    "scheduler": "cosine",
    "early_stopping_patience": 5,
    "eval_every": 1
  },
  "unlearning": {
    "algorithms": [
      "retraining",
      "sisa",
      "scrub"
    ],
    "forget_ratios": [
      0.1
    ],
    "num_runs": 1,
    "seed_start": 42
  },
  "privacy": {
    "mia_num_samples": 200,
    "mia_threshold_percentile": 50.0,
    "membership_leakage_bins": 50,
    "attack_confidence_level": 0.95
  },
  "output": {
    "output_dir": "evaluation/results",
    "export_csv": false,
    "export_json": false,
    "export_latex": false,
    "export_figures": false,
    "figure_format": "pdf",
    "figure_dpi": 300,
    "latex_font_size": "small",
    "journal_style": true
  }
}