# --- App ---
ENV=development
DEBUG=false

# --- Auth (CHANGE IN PRODUCTION) ---
SECRET_KEY=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database (SQLite default for dev; Postgres for prod) ---
# DATABASE_URL=postgresql+asyncpg://veriunlearn:veriunlearn@localhost:5432/veriunlearn
DATABASE_URL=sqlite+aiosqlite:///./veriunlearn.db

# --- Redis (optional, used for rate limiting / caching) ---
REDIS_URL=

# --- Vector store ---
VECTOR_STORE_BACKEND=memory
QDRANT_URL=
QDRANT_API_KEY=

# --- ML ---
DEFAULT_SHARD_COUNT=4
MAX_UPLOAD_MB=50

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Blockchain (optional) ---
BLOCKCHAIN_ENABLED=false
BLOCKCHAIN_RPC_URL=
BLOCKCHAIN_REGISTRY_ADDRESS=
BLOCKCHAIN_PRIVATE_KEY=
