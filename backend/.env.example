# VeriUnlearn backend environment — copy to .env and fill in values.
#   Windows:  copy .env.example .env
#   macOS/Linux: cp .env.example .env
# Never commit your real .env — this file is a template only.

# ---- App ----
ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_MB=50

# ---- Database (SQLite for dev, PostgreSQL for prod) ----
DATABASE_URL=sqlite+aiosqlite:///./veriunlearn.db

# ---- SISA engine ----
DEFAULT_SHARD_COUNT=4

# ---- Assistant / LLM (OpenAI-compatible endpoint) ----
# Leave LLM_BASE_URL empty to disable the live chat assistant.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# ---- Vector store ----
VECTOR_STORE_BACKEND=memory
QDRANT_URL=
QDRANT_API_KEY=

# ---- Redis / cache (optional) ----
REDIS_URL=

# ---- Rate limiting ----
RATE_LIMIT_DEFAULT=100/minute
API_KEY_DEFAULT_QUOTA=60

# ---- Monitoring ----
PROMETHEUS_ENABLED=false
METRICS_TOKEN=change-me

# ---- Blockchain (optional) ----
BLOCKCHAIN_ENABLED=false
BLOCKCHAIN_RPC_URL=
BLOCKCHAIN_REGISTRY_ADDRESS=

# ---- Email notifications (optional) ----
EMAIL_PROVIDER=null
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@veriunlearn.dev
NOTIFICATION_MAX_ATTEMPTS=5