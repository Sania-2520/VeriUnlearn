# ─── Database ──────────────────────────────────────────────
POSTGRES_USER=veriunlearn
POSTGRES_PASSWORD=veriunlearn_secret
POSTGRES_DB=veriunlearn
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://veriunlearn:veriunlearn_secret@localhost:5432/veriunlearn

# ─── Redis ─────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=veriunlearn_secret
REDIS_URL=redis://:veriunlearn_secret@localhost:6379/0

# ─── Qdrant ────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_URL=http://localhost:6333

# ─── MinIO ─────────────────────────────────────────────────
MINIO_ROOT_USER=veriunlearn
MINIO_ROOT_PASSWORD=veriunlearn_secret
MINIO_HOST=localhost
MINIO_PORT=9000
MINIO_BUCKET=models
MINIO_ENDPOINT=localhost:9000

# ─── JWT ───────────────────────────────────────────────────
JWT_SECRET_KEY=replace-with-strong-random-key-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER=veriunlearn
JWT_AUDIENCE=veriunlearn-api

# ─── ML Engine ─────────────────────────────────────────────
ML_ENGINE_URL=http://localhost:8001
ML_ENGINE_API_KEY=
BASE_MODEL_NAME=Qwen/Qwen2.5-1.5B-Instruct
ML_DEVICE=cpu
DEVICE=cpu
QUANTIZATION_BITS=4
LORA_R=16
LORA_ALPHA=32
LORA_DROPOUT=0.1

# ─── Celery ────────────────────────────────────────────────
CELERY_BROKER_URL=redis://:veriunlearn_secret@localhost:6379/1
CELERY_RESULT_BACKEND=redis://:veriunlearn_secret@localhost:6379/2
CELERY_WORKER_CONCURRENCY=4

# ─── OpenTelemetry ─────────────────────────────────────────
OTEL_SERVICE_NAME=veriunlearn
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# ─── App ───────────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=replace-with-secret-key-at-least-32-chars
DOMAIN=localhost:3000
ALLOWED_HOSTS=

# ─── Services ──────────────────────────────────────────────
BACKEND_PORT=8000
ML_ENGINE_PORT=8001
FRONTEND_PORT=3000
HTTP_PORT=80
HTTPS_PORT=443
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
GRAFANA_PORT=3001
LOKI_PORT=3100

# ─── Frontend ──────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# ─── OAuth / SSO ───────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── AI Providers ──────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
HUGGINGFACE_API_TOKEN=

# ─── Security / Compliance ─────────────────────────────────
COMPLIANCE_GDPR_CONTACT=
COMPLIANCE_AI_ACT_CONTACT=
SENTRY_DSN=
