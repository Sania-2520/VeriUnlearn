# ─── VeriUnlearn Environment Variables ───────────────────────────
# Copy to .env and fill in your values

# ─── General ────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=DEBUG
SECRET_KEY=change-me-to-a-random-256-bit-key
APP_NAME=VeriUnlearn
VERSION=1.0.0
DOMAIN=localhost:3000

# ─── PostgreSQL ─────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://veriunlearn:veriunlearn@localhost:5432/veriunlearn
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40
DATABASE_ECHO=false

# ─── Redis ──────────────────────────────────────────────────────
REDIS_URL=redis://:password@localhost:6379/0
REDIS_SOCKET_TIMEOUT=5
REDIS_RETRY_ON_TIMEOUT=true

# ─── RabbitMQ ──────────────────────────────────────────────────
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_DEFAULT_QUEUE=veriunlearn

# ─── Celery ─────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://:password@localhost:6379/1
CELERY_RESULT_BACKEND=redis://:password@localhost:6379/2
CELERY_WORKER_CONCURRENCY=4
CELERY_TASK_ALWAYS_EAGER=false

# ─── JWT ────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-a-random-256-bit-key
JWT_ALGORITHM=RS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER=veriunlearn
JWT_AUDIENCE=veriunlearn-api

# ─── OAuth ──────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/oauth/google/callback

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3000/api/v1/auth/oauth/github/callback

# ─── Email (SMTP) ──────────────────────────────────────────────
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=
SMTP_FROM=noreply@veriunlearn.com
SMTP_FROM_NAME=VeriUnlearn

# ─── AI Providers ───────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_ORGANIZATION=

ANTHROPIC_API_KEY=

GOOGLE_API_KEY=

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3

VLLM_BASE_URL=http://localhost:8000

HUGGINGFACE_API_TOKEN=

# ─── Qdrant ────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_DOCUMENTS=documents
QDRANT_COLLECTION_MEMORY=memory
QDRANT_COLLECTION_CONVERSATIONS=conversations
QDRANT_VECTOR_SIZE=1536
QDRANT_REPLICATION_FACTOR=2

# ─── MinIO ──────────────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=veriunlearn
MINIO_SECRET_KEY=change-me-to-a-random-key
MINIO_USE_SSL=false
MINIO_DOCUMENTS_BUCKET=documents
MINIO_UPLOADS_BUCKET=uploads
MINIO_MODELS_BUCKET=models
MINIO_PROOFS_BUCKET=proofs
MINIO_EXPORTS_BUCKET=exports
MINIO_TEMP_BUCKET=temp

# ─── ML Engine ──────────────────────────────────────────────────
ML_MODEL_CACHE_DIR=/data/model_cache
ML_DEFAULT_EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
ML_DEFAULT_LLM=mistralai/Mistral-7B-Instruct-v0.3
ML_TRAINING_BATCH_SIZE=32
ML_TRAINING_EPOCHS=10
ML_LEARNING_RATE=2e-5
ML_MAX_SEQ_LENGTH=512
ML_USE_GPU=true
ML_GPU_DEVICES=0,1
ML_MIXED_PRECISION=fp16
ML_FLUSH_INTERVAL=100

# ─── Unlearning ────────────────────────────────────────────────
UNLEARNING_DEFAULT_ALGORITHM=hybrid
UNLEARNING_SISA_SHARDS=10
UNLEARNING_INFLUENCE_BATCH_SIZE=64
UNLEARNING_CERTIFIED_EPSILON=0.1
UNLEARNING_CERTIFIED_DELTA=1e-5
UNLEARNING_MAX_RETRIES=3
UNLEARNING_QUEUE_MAX_SIZE=10000
UNLEARNING_WORKER_TIMEOUT=300

# ─── Verification ──────────────────────────────────────────────
VERIFICATION_KEY_TYPE=ed25519
VERIFICATION_MERKLE_HASH_ALGORITHM=SHA256
VERIFICATION_ZK_ENABLED=false
VERIFICATION_CERTIFICATE_EXPIRY_DAYS=365

# ─── Security ──────────────────────────────────────────────────
SECURITY_MIA_ATTACK_RATIO=0.1
SECURITY_NUM_SHADOW_MODELS=5
SECURITY_EXTRACTION_QUERY_LIMIT=1000
SECURITY_MAX_SCORE_THRESHOLD=0.1
SECURITY_SCAN_INTERVAL_HOURS=24

# ─── Audit ──────────────────────────────────────────────────────
AUDIT_BLOCKCHAIN_ANCHORING=false
AUDIT_BLOCKCHAIN_NETWORK=goerli
AUDIT_ETHEREUM_CONTRACT_ADDRESS=
AUDIT_ETHEREUM_PRIVATE_KEY=
AUDIT_EVENT_RETENTION_DAYS=3650

# ─── Compliance ────────────────────────────────────────────────
COMPLIANCE_GDPR_CONTACT=
COMPLIANCE_AI_ACT_CONTACT=
COMPLIANCE_DPDP_CONTACT=
COMPLIANCE_REPORT_AUTO_GENERATE=true
COMPLIANCE_REPORT_SCHEDULE=0 0 1 * *

# ─── Monitoring ────────────────────────────────────────────────
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
OPENTELEMETRY_ENABLED=true
OPENTELEMETRY_ENDPOINT=http://localhost:4317

# ─── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=20/minute
RATE_LIMIT_STREAMING=30/minute
RATE_LIMIT_UNLEARNING=10/minute

# ─── File Upload ───────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=100
ALLOWED_UPLOAD_TYPES=image/jpeg,image/png,application/pdf,text/plain,text/csv,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# ─── CORS ──────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
CORS_ALLOW_CREDENTIALS=true

# ─── Vault (optional) ──────────────────────────────────────────
VAULT_ENABLED=false
VAULT_URL=http://localhost:8200
VAULT_TOKEN=
VAULT_KV_PATH=veriunlearn
