# Database
POSTGRES_USER=veriunlearn
POSTGRES_PASSWORD=veriunlearn_secret
POSTGRES_DB=veriunlearn
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333

# MinIO
MINIO_ROOT_USER=veriunlearn
MINIO_ROOT_PASSWORD=veriunlearn_secret
MINIO_HOST=localhost
MINIO_PORT=9000
MINIO_BUCKET=models

# JWT
JWT_SECRET_KEY=replace-with-strong-random-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ML
BASE_MODEL_NAME=Qwen/Qwen2.5-1.5B-Instruct
DEVICE=cuda
QUANTIZATION_BITS=4
LORA_R=16
LORA_ALPHA=32
LORA_DROPOUT=0.1

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# OpenTelemetry
OTEL_SERVICE_NAME=veriunlearn
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# App
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=replace-with-secret
