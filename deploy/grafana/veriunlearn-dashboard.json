{
  "title": "VeriUnlearn — Platform Overview",
  "uid": "veriunlearn-platform",
  "version": 1,
  "editable": false,
  "timezone": "utc",
  "refresh": "15s",
  "panels": [
    {
      "id": 1,
      "title": "HTTP requests per second",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(veriunlearn_http_requests_total[5m]))",
          "legendFormat": "rps"
        }
      ]
    },
    {
      "id": 2,
      "title": "Request latency (p50/p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(veriunlearn_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(veriunlearn_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 3,
      "title": "Error rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(veriunlearn_http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(veriunlearn_http_requests_total[5m])), 0.0001)",
          "legendFormat": "error rate"
        }
      ]
    },
    {
      "id": 4,
      "title": "System resources",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "datasource": "Prometheus",
      "targets": [
        { "expr": "veriunlearn_system_cpu_percent", "legendFormat": "CPU %" },
        { "expr": "veriunlearn_system_ram_mb / 1024", "legendFormat": "RAM (GB)" },
        { "expr": "veriunlearn_disk_used_mb / 1024", "legendFormat": "disk (GB)" }
      ]
    },
    {
      "id": 5,
      "title": "Deletion queue in flight",
      "type": "stat",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "datasource": "Prometheus",
      "targets": [
        { "expr": "veriunlearn_deletion_queue_in_flight", "legendFormat": "in flight" }
      ],
      "options": { "colorMode": "value", "graphMode": "area" }
    },
    {
      "id": 6,
      "title": "API latency & uptime",
      "type": "stat",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "datasource": "Prometheus",
      "targets": [
        { "expr": "veriunlearn_api_avg_latency_ms", "legendFormat": "avg latency ms" },
        { "expr": "veriunlearn_uptime_seconds / 3600", "legendFormat": "uptime (h)" }
      ],
      "options": { "colorMode": "value", "graphMode": "none" }
    }
  ],
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "schemaVersion": 39
}
