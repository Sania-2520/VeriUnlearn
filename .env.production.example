# =============================================================================
# VeriUnlearn — PRODUCTION environment template
# Copy to `.env` and adjust secrets before deploying.
# NEVER commit a populated .env file. This template contains NO real secrets.
# =============================================================================

# ─── Core ────────────────────────────────────────────────────────────────
APP_ENV=production
APP_DEBUG=false
APP_SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
DOMAIN=veriunlearn.example.com
ALLOWED_HOSTS=veriunlearn.example.com,localhost

# ─── Database (PostgreSQL) ───────────────────────────────────────────────
POSTGRES_USER=veriunlearn
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=veriunlearn
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://veriunlearn:CHANGE_ME_strong_db_password@postgres:5432/veriunlearn

# ─── Cache / Queue (Redis) ───────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_strong_redis_password
REDIS_URL=redis://:CHANGE_ME_strong_redis_password@redis:6379/0
CELERY_BROKER_URL=redis://:CHANGE_ME_strong_redis_password@redis:6379/1
CELERY_RESULT_BACKEND=redis://:CHANGE_ME_strong_redis_password@redis:6379/2
CELERY_WORKER_CONCURRENCY=4

# ─── Vector Store (Qdrant) ───────────────────────────────────────────────
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_URL=http://qdrant:6333

# ─── Object Storage (MinIO / S3) ─────────────────────────────────────────
MINIO_ROOT_USER=veriunlearn
MINIO_ROOT_PASSWORD=CHANGE_ME_strong_minio_password
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_BUCKET=models
MINIO_ENDPOINT=minio:9000
AWS_ACCESS_KEY_ID=veriunlearn
AWS_SECRET_ACCESS_KEY=CHANGE_ME_strong_minio_password
AWS_REGION=us-east-1
S3_BUCKET_NAME=veriunlearn-data

# ─── Auth / JWT ──────────────────────────────────────────────────────────
JWT_SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER=veriunlearn
JWT_AUDIENCE=veriunlearn-api
ENCRYPTION_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32

# ─── ML Engine ───────────────────────────────────────────────────────────
ML_ENGINE_URL=http://ml-engine:8000
ML_ENGINE_API_KEY=
BASE_MODEL_NAME=Qwen/Qwen2.5-1.5B-Instruct
ML_DEVICE=cpu
DEVICE=cpu
QUANTIZATION_BITS=4
LORA_R=16
LORA_ALPHA=32
LORA_DROPOUT=0.1

# ─── Frontend ────────────────────────────────────────────────────────────
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=https://veriunlearn.example.com/api/v1
CORS_ORIGINS=https://veriunlearn.example.com

# ─── Telemetry / Observability ───────────────────────────────────────────
OTEL_SERVICE_NAME=veriunlearn
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
PROMETHEUS_ENABLED=true
LOG_FORMAT=json
LOG_LEVEL=info

# ─── Service Ports (host mappings) ───────────────────────────────────────
BACKEND_PORT=8000
ML_ENGINE_PORT=8001
HTTP_PORT=80
HTTPS_PORT=443
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
GRAFANA_PORT=3001
LOKI_PORT=3100

# ─── Monitoring Credentials (change before production) ───────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_strong_grafana_password

# ─── Image Registry (for pinned deployments) ─────────────────────────────
IMAGE_REGISTRY=ghcr.io/veriunlearn
IMAGE_TAG=latest

# ─── Compliance / Integrations (optional) ───────────────────────────────
COMPLIANCE_GDPR_CONTACT=privacy@veriunlearn.com
COMPLIANCE_AI_ACT_CONTACT=legal@veriunlearn.com
SENTRY_DSN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
HUGGINGFACE_API_TOKEN=
